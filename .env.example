DATABASE_URL=postgresql+psycopg://vetglobal:vetglobal@localhost:5432/vetglobal
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
ALLOWED_FRONTEND_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
MAX_FILE_SIZE_BYTES=5242880
MAX_REQUEST_BODY_BYTES=5505024
POLLING_TIMEOUT_SECONDS=25
POLLING_INTERVAL_SECONDS=0.5

# Tests use a separate database and refuse a URL whose database name lacks "test".
TEST_DATABASE_URL=postgresql+psycopg://vetglobal:vetglobal@localhost:5433/vetglobal_test
